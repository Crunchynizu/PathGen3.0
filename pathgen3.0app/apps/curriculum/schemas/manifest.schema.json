{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "curriculum_version", "scoring_policy", "counts", "source_files", "pretest_posttest_sha256", "skills", "prepost_rewrites"],
  "properties": {
    "schema_version": {"const": 1},
    "curriculum_version": {"type": "string", "minLength": 1},
    "scoring_policy": {
      "type": "object",
      "required": ["code", "correct_required"],
      "properties": {
        "code": {"const": "SCORING-V3"},
        "description": {"type": "string"},
        "correct_required": {"const": {"3": 2, "6": 4}}
      }
    },
    "counts": {"type": "object"},
    "source_files": {"type": "object"},
    "pretest_posttest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "description", "p_l0", "p_t", "p_g", "p_s"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "p_l0": {"type": "string"},
          "p_t": {"type": "string"},
          "p_g": {"type": "string"},
          "p_s": {"type": "string"},
          "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "junyi_exercises": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "prepost_rewrites": {"type": "array", "minItems": 1}
  }
}
