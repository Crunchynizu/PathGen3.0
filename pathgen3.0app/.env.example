OPENAI_API_KEY=
# Embeddings service for the RAG index: gemini (default, needs GEMINI_API_KEY) or openai
# (needs OPENAI_API_KEY). The model follows the provider: gemini-embedding-001 or
# text-embedding-3-small. Rebuild the index after changing it: manage.py build_retrieval_index
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
