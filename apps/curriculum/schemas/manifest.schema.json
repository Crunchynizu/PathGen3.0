{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "curriculum_version", "scoring_policy", "counts", "source_files", "pretest_posttest_sha256", "skills", "prepost_rewrites"],
  "properties": {
    "schema_version": {"const": 1},
    "curriculum_version": {"type": "string", "minLength": 1},
    "scoring_policy": {
      "type": "object",
      "required": ["code", "correct_required", "questions_per_skill"],
      "properties": {
        "code": {"const": "SCORING-V2"},
        "correct_required": {"const": 2},
        "questions_per_skill": {"const": 3}
      }
    },
    "counts": {"type": "object"},
    "source_files": {"type": "object"},
    "pretest_posttest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skills": {"type": "array", "minItems": 6, "maxItems": 6},
    "prepost_rewrites": {"type": "array", "minItems": 1}
  }
}
