{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media_manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "videos", "figures"],
  "properties": {
    "schema_version": {"const": 1},
    "videos": {"type": "array", "minItems": 4, "maxItems": 4},
    "figures": {"type": "array"}
  }
}
