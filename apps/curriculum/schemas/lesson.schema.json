{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "type": "object",
  "required": ["schema_version", "lesson", "question_sets"],
  "properties": {
    "schema_version": {"const": 1},
    "lesson": {
      "type": "object",
      "required": ["code", "slug", "lesson_order", "title", "summary", "skill_codes", "content_schema_version", "content"],
      "properties": {
        "code": {"pattern": "^L[1-3]$"},
        "slug": {"type": "string", "minLength": 1},
        "lesson_order": {"type": "integer", "minimum": 1, "maximum": 3},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "skill_codes": {"type": "array", "minItems": 2, "maxItems": 2},
        "content_schema_version": {"const": 1},
        "content": {
          "type": "object",
          "required": ["source_text"],
          "properties": {"source_text": {"type": "string", "minLength": 1}}
        }
      }
    },
    "question_sets": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "question_set.schema.json"}}
  }
}
